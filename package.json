{
  "name": "pi-sec",
  "version": "0.1.0",
  "description": "Autonomous personal agent (secretary) built on @earendil-works/pi-durable",
  "type": "module",
  "license": "MIT",
  "author": "Hyeonu Park (https://github.com/HyeonuPark)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyeonuPark/pi-sec.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "pi-sec": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "prompts",
    "THIRD_PARTY_NOTICES.md",
    "user-tools"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "pretest:browser": "npm run build",
    "test:browser": "vitest --run --config vitest.browser.config.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "scan": "node scripts/scan-tree.mjs",
    "start": "node dist/cli.js start"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "parse5": "8.0.1",
    "quickjs-wasi": "3.6.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@preact/signals": "2.11.4",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.2",
    "highlight.js": "11.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.2",
    "markdown-it": "^15.0.3",
    "playwright": "^1.64.0",
    "preact": "11.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
